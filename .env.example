# ==========================================
# IUTECP Asistente Virtual - Variables de Entorno
# ==========================================

# Proveedor de Modelo: 'gemini', 'openai' u 'offline'
MODEL_PROVIDER=gemini

# Google Gemini API Key (Recomendado - Gratuito para prototipos en aistudio.google.com)
GEMINI_API_KEY=

# Modelo Gemini (ej. gemini-1.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Configuración RAG
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RESULTS=4

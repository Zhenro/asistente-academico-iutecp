# ==========================================
# IUTECP Asistente Virtual - Variables de Entorno
# ==========================================

# Proveedor de Modelo: 'gemini', 'openai' u 'offline'
MODEL_PROVIDER=gemini

# Google Gemini API Key (Recomendado - Gratuito para prototipos en aistudio.google.com)
GEMINI_API_KEY=

# Modelo Gemini (ej. gemini-flash-lite-latest, gemini-2.5-flash)
GEMINI_MODEL=gemini-flash-lite-latest

# OpenAI API Key (Opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Telegram Bot Token (Opcional - Obtener gratis en Telegram con @BotFather)
TELEGRAM_BOT_TOKEN=

# Configuración RAG
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RESULTS=4
